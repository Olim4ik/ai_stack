# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Embedding Service
EMBEDDING_PORT=50052
EMBEDDING_MODEL_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_MAX_BATCH_SIZE=64

# Retrieval Service
RETRIEVAL_PORT=50051
EMBEDDING_SERVICE_HOST=embedding:50052
DEFAULT_TOP_K=5
HYBRID_DENSE_WEIGHT=0.7

# Agent Service
AGENT_SERVICE_HOST=agent:50053
RETRIEVAL_SERVICE_HOST=retrieval:50051

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MCP Server
MCP_TRANSPORT=stdio
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GITHUB_TOKEN=
PAGERDUTY_API_KEY=
